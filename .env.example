# ===================================================
# DESA WISATA EKANG ANCULAI - ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================

# Application Environment Mode (production | development)
NODE_ENV=production

# Server Host & Network Port
PORT=8080
HOST=0.0.0.0

# Site URLs (Base URL for SEO, JSON-LD, Sitemap)
SITE_URL=https://desawisataekanganculai.id
APP_URL=https://desawisataekanganculai.id

# Admin Initial Bootstrap Credentials (Required on fresh database setup)
# Set a strong, unique password before starting the app for the first time
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# Session Cryptographic Secret (Optional 64-character hex secret for extra entropy)
SESSION_SECRET=

# Database Engine Mode: 'supabase' (Default Production) | 'sqlite' (Development / Emergency Rollback)
DATABASE_MODE=supabase

# Local SQLite Database Path (Development only)
DATABASE_PATH=data/ekang_anculai.db

# Supabase PostgreSQL Database Credentials (For Production Migration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

